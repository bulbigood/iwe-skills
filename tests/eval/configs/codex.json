{
  "name": "codex",
  "agent_command": "codex exec --json --ephemeral --ignore-user-config --skip-git-repo-check -s workspace-write -m gpt-5.6-terra -c model_reasoning_effort=\"medium\" -",
  "judge_command": "codex exec --json --ephemeral --ignore-user-config --skip-git-repo-check -s read-only -m gpt-5.6-sol -c model_reasoning_effort=\"low\" --output-schema {judge_schema} -",
  "timeout_seconds": 1800,
  "jobs": 3,
  "samples": 1,
  "min_pass_rate": 1.0,
  "fixtures": {
    "seventeen-centuries": {
      "repository": "https://github.com/iwe-org/seventeen-centuries.git",
      "commit": "acc00aeabee4fd510c54e9e9033d6b9869aedc3d"
    },
    "pkm-demo": {
      "repository": "https://github.com/iwe-org/pkm-demo.git",
      "commit": "76007db0c64c3ee170e2a8869a88e7c61909d489"
    }
  }
}
