{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bulbigood/iwe-skills/tests/eval/scenario.schema.json",
  "title": "IWE evaluation scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"const": 2},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "excellent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_correctness", "scenario_compliance", "evidence_quality"],
      "properties": {
        "task_correctness": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "scenario_compliance": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "skill_compliance": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "safety": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_quality": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "semanticSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ideal", "stop_when", "avoid"],
      "properties": {
        "ideal": {"$ref": "#/$defs/semanticSteps"},
        "acceptable_variations": {"$ref": "#/$defs/semanticSteps"},
        "stop_when": {"$ref": "#/$defs/semanticSteps"},
        "avoid": {"$ref": "#/$defs/semanticSteps"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "fixture", "request", "procedure", "efficiency", "excellent"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "fixture": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "request": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "skill_activation": {"enum": ["required", "forbidden"]},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["real", "unavailable"]},
            "output_bytes": {"type": "integer", "minimum": 1},
            "allow_filesystem_fallback": {"type": "boolean"},
            "max_iwe_calls": {"type": "integer", "minimum": 1},
            "hard_max_task_tool_calls": {"type": "integer", "minimum": 0},
            "forbidden_retrieve_keys": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "require_oracle_tool_evidence": {"type": "boolean"}
          }
        },
        "efficiency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_tool_calls", "task_tool_output_bytes"],
          "properties": {
            "task_tool_calls": {"$ref": "#/$defs/range"},
            "task_tool_output_bytes": {"$ref": "#/$defs/range"}
          }
        },
        "excellent": {"$ref": "#/$defs/excellent"},
        "procedure": {"$ref": "#/$defs/procedure"}
      }
    }
  }
}
